# Independent profile; does not change the existing Qwen2.5-Coder-7B settings.
QWEN3_CODEGEN_MODEL="${QWEN3_CODEGEN_MODEL:-Qwen/Qwen3-Coder-30B-A3B-Instruct}"
QWEN3_CODEGEN_REVISION="${QWEN3_CODEGEN_REVISION:-main}"
QWEN3_CODEGEN_CONTAINER="${QWEN3_CODEGEN_CONTAINER:-cpo-vllm-qwen3-30b-h200}"
QWEN3_CODEGEN_CACHE="${QWEN3_CODEGEN_CACHE:-cpo-vllm-qwen3-30b-hf-h200}"
QWEN3_CODEGEN_PORT="${QWEN3_CODEGEN_PORT:-8001}"
QWEN3_CODEGEN_EXPERIMENT="${QWEN3_CODEGEN_EXPERIMENT:-qwen3-coder-30b-h200-v1}"
# Context, BF16, generation budget and greedy protocol are inherited from h200.env.
# The H200 start command resolves and records the exact image and model commit.
