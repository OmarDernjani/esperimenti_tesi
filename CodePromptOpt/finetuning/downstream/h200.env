# Persistent H200 code-generator settings. Change the experiment ID for new runs.
# Training/prompt-generation settings are loaded first from ../podman.env.
export VLLM_IMAGE="${VLLM_IMAGE:-docker.io/vllm/vllm-openai:latest}"
export CODEGEN_MODEL="${CODEGEN_MODEL:-Qwen/Qwen2.5-Coder-7B-Instruct}"
export CODEGEN_GPU="${CODEGEN_GPU:-$CPO_GPU}"
export CODEGEN_CONTAINER="${CODEGEN_CONTAINER:-cpo-vllm-h200}"
export CODEGEN_CACHE="${CODEGEN_CACHE:-cpo-vllm-hf-h200}"
export CODEGEN_PORT="${CODEGEN_PORT:-8000}"
export CODEGEN_CONTEXT="${CODEGEN_CONTEXT:-16384}"
export CODEGEN_GPU_UTIL="${CODEGEN_GPU_UTIL:-0.70}"
export CODEGEN_MAX_SEQS="${CODEGEN_MAX_SEQS:-4}"
export CODEGEN_REVISION="${CODEGEN_REVISION:-main}"
export CPO_CLIENT_IMAGE="${CPO_CLIENT_IMAGE:-localhost/cpo-codegen-client:1}"
export CPO_CODEGEN_INPUT="${CPO_CODEGEN_INPUT:-$CPO_OUTPUT/runs}"
export CPO_CODEGEN_OUTPUT="${CPO_CODEGEN_OUTPUT:-CodePromptOpt/finetuning/outputs/codegen}"
export CPO_CODEGEN_EXPERIMENT="${CPO_CODEGEN_EXPERIMENT:-qwen25-coder-7b-h200-v1}"
