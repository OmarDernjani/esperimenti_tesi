# Persistent defaults, loaded by podman.sh on every invocation.
# Edit CPO_OUTPUT here when starting a new battery; explicit --output wins.
# External environment variables override these defaults.
export CPO_GPU="${CPO_GPU:-3}"
export CPO_CONTAINER_NAME="${CPO_CONTAINER_NAME:-cpo-gpu-${CPO_GPU//[^a-zA-Z0-9_.-]/-}}"
export CPO_IMAGE="${CPO_IMAGE:-localhost/codepromptopt-ft:h200}"
export CPO_CACHE="${CPO_CACHE:-cpo-hf-cache}"
export CPO_OUTPUT="${CPO_OUTPUT:-CodePromptOpt/finetuning/outputs/h200-batteria-v1}"
