# Persistent DPO settings. External overrides take precedence.
export CPO_DPO_GPU="${CPO_DPO_GPU:-3}"
export CPO_DPO_IMAGE="${CPO_DPO_IMAGE:-localhost/codepromptopt-dpo:h200-v1}"
export CPO_DPO_CONTAINER="${CPO_DPO_CONTAINER:-cpo-dpo-gpu-3}"
export CPO_DPO_CACHE="${CPO_DPO_CACHE:-cpo-hf-cache}"
export CPO_DPO_ROOT="${CPO_DPO_ROOT:-CodePromptOpt/finetuning/outputs/dpo-qwen3-8b-v1}"
export CPO_DPO_CONFIG="${CPO_DPO_CONFIG:-CodePromptOpt/finetuning/dpo/qwen3_8b.json}"
export CPO_DPO_CODEGEN_EXPERIMENT="${CPO_DPO_CODEGEN_EXPERIMENT:-qwen3-coder-30b-dpo8b-v1}"
